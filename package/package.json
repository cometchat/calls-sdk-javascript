{
  "name": "@cometchat/calls-sdk-javascript",
  "private": false,
  "version": "5.0.7",
  "type": "module",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test:unit": "vitest run",
    "dev": "npm run ensure:vb-worker && export VITE_APP=sample-app-sdk && vite",
    "dev:recorder": "export VITE_APP=recorder && vite",
    "dev:js": "npm run ensure:vb-worker && export VITE_APP=sample-app-javascript && vite --port 3000",
    "dev:test": "npm run ensure:vb-worker && export NODE_ENV=playwright-test && export VITE_APP=e2e && vite",
    "build": "npm run ensure:vb-worker && tsc -b ./tsconfig.app.json && vite build",
    "build:recorder": "VITE_APP=recorder npm run build && rm -rf dist/.well-known",
    "build:lib": "npm run build:vb-worker && tsc -b ./tsconfig.build.json && vite --config=vite.config.js.ts build",
    "build:vb-worker": "vite --config=vite.config.worker.ts build",
    "ensure:vb-worker": "node scripts/ensure-vb-worker.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "tsc": "tsc -b ./tsconfig.app.json ./tsconfig.worker.json",
    "test": "npx vitest --run",
    "test:e2e": "npx playwright test --ui e2e/visual/tile-mode-responsive.spec.ts"
  },
  "dependencies": {
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@playwright/test": "1.60.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@tensorflow-models/body-segmentation": "1.0.2",
    "@tensorflow/tfjs-backend-webgl": "4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/audioworklet": "^0.0.77",
    "@types/emscripten": "^1.40.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-react": "^4.4.1",
    "clsx": "^2.1.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-window": "^1.8.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "zustand": "^5.0.4"
  }
}
